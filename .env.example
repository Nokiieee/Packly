# Copy to .env.local and fill in from your Supabase project:
# Dashboard -> Project Settings -> Data API (URL) and API Keys (publishable/anon key).
#
# Both values are exposed to the browser by design. The publishable/anon key is
# safe to ship to clients -- it only grants what your Row Level Security policies
# allow. Never put the service_role key in a NEXT_PUBLIC_ variable; it bypasses
# RLS entirely and must stay server-side.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional. Used to build the email confirmation link when request headers
# can't be trusted (e.g. behind some proxies). Defaults to the request origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
